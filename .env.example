# Copy to .env and choose your own local development password.
POSTGRES_DB=platform_admin
POSTGRES_USER=platform_admin
POSTGRES_PASSWORD=REPLACE_WITH_YOUR_LOCAL_PASSWORD

# Events & Resources backend origin, reachable from inside the backend container.
# Example for that service running on its default port: http://host.docker.internal:8080
# Leave blank until the service is available. Its metrics will show Unavailable.
EVENTS_API_URL=
